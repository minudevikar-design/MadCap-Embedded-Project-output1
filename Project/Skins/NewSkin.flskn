<?xml version="1.0" encoding="utf-8"?>
<CatapultSkin
  Version="6"
  SkinType="Component"
  Comment="HTML5 Test Results skin"
  ComponentType="TestResults"
  EnableResponsiveOutput="True"
  ShowPassFail="true"
  ShowScore="true"
  ShowQuestions="true"
  ShowUserAnswers="true"
  ShowCorrectAnswers="true"
  ShowQuestionFeedback="true"
  ScoreType="PercentageCorrect">
  <Stylesheet>
    <Styles>
      <Style
        Name="Title">
        <Properties>
          <Property
            Name="BackgroundGradient">vertical 2e8b57 #2e8b57</Property>
          <Property
            Name="Color">#228b22</Property>
        </Properties>
      </Style>
    </Styles>
  </Stylesheet>
  <Strings />
</CatapultSkin>